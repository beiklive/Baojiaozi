{
  "id": "home",
  "title": "主页",
  "root": {
    "id": "home_root",
    "type": "vertical",
    "properties": {"padding": 32, "gap": 16},
    "children": [
      {
        "id": "home_title",
        "type": "text",
        "properties": {"text": "JiaoZiPi", "fontSize": 32},
        "style": "text.title"
      },
      {
        "id": "home_subtitle",
        "type": "text",
        "properties": {"text": "多核心模拟器前端", "fontSize": 18},
        "style": "text.subtitle"
      },
      {
        "id": "open_library",
        "type": "button",
        "properties": {"text": "游戏库"},
        "style": "button.primary",
        "states": {
          "focused": {"background": "#67A7F2", "cornerRadius": 10},
          "triggered": {"background": "#2E6CAD", "cornerRadius": 4},
          "blurred": {"background": "#4A90E2"},
          "disabled": {"background": "#555B64", "textColor": "#B7BBC2"}
        },
        "bindings": {
          "onTrigger": {"action": "navigate.page", "pageId": "library"}
        },
        "animations": {
          "focus": "button_focus",
          "trigger": "button_trigger"
        }
      }
    ]
  }
}
